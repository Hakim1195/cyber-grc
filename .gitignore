# Dépendances et artefacts de compilation du backend
backend/node_modules/
backend/dist/

# Secrets et configuration locale — jamais dans le dépôt.
# Seul backend/.env.example, qui ne contient aucune valeur réelle, est versionné.
.env
backend/.env
backend/.env.*
!backend/.env.example

# Magasin de pièces jointes (données client, hors arborescence web)
backend/var/
backend/pieces-jointes/

# Journaux
*.log
npm-debug.log*

# Réglages locaux Claude Code (machine de l'utilisateur, non partagés)
.claude/settings.local.json
.claude/session-state/

# Python (caches générés par les scripts de la skill ui-ux-pro-max)
__pycache__/
*.py[cod]

# Sorties générées par la skill (--design-system --persist)
design-system/

# Divers systèmes
.DS_Store
Thumbs.db

# Fichiers locaux, non partagés — notes de travail et mémoire, hors dépôt.
# ⚠️ Les deux lignes sont nécessaires : le glob ne couvre QUE les noms en
# « .local.md ». Une version antérieure de ce bloc l'avait réduit au seul glob,
# et « MEMORY.md » cessait d'être ignoré sans que rien ne le dise.
*.local.md
MEMORY.md

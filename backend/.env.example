# =====================================================================
#  Cyber GRC Groupe — modèle de configuration du serveur applicatif
# =====================================================================
#
#  Ce fichier est un MODÈLE versionné dans le dépôt. Il ne contient
#  AUCUN secret et ne doit JAMAIS en contenir (cadrage §1.9).
#
#  Sur la machine cible, la configuration réelle vit dans :
#       /etc/cyber-grc/env        (root:cyber-grc, mode 0640)
#  Elle est produite par `deploy/install.sh`, qui y engendre les secrets,
#  puis chargée par systemd (`EnvironmentFile=`). Le compte de service est
#  le seul, avec root, à pouvoir la lire.
#
#  En développement : copier ce fichier en `backend/.env` (NON versionné)
#  et lancer `npm run dev` (Node le charge via --env-file).
#
#  Format : CLE=valeur, une par ligne, sans `export`, sans guillemets sauf
#  si la valeur contient des espaces. Ni interpolation ni commande shell :
#  systemd n'interprète pas ce fichier comme du shell.
#
#  Légende :   [requis]   absence = refus de démarrer
#              [socle]    valeur par défaut du produit, rarement modifiée
#              [client]   valeur propre au déploiement (§0.5 du plan)
# ---------------------------------------------------------------------


# =====================================================================
#  1. Général
# =====================================================================

# production | recette | developpement   [requis en production]
# `recette` active les mêmes contrôles que la production mais autorise
# la redirection des courriels (§1.10 : la recette n'écrit jamais aux filiales).
NODE_ENV=production

# Version affichée par /api/sante et tracée dans le journal d'audit (§0.3).
# Vide = version lue dans package.json. Renseignée par install.sh.
APPLICATION_VERSION=


# =====================================================================
#  2. Serveur HTTP (derrière Apache — jamais exposé directement)
# =====================================================================

# Port d'écoute du service Node. Apache est le seul point d'entrée. [socle]
SERVEUR_PORT=3001

# Interface d'écoute. Boucle locale UNIQUEMENT : Apache termine le TLS. [socle]
SERVEUR_HOTE=127.0.0.1

# URL publique servie par Apache (liens des courriels, exports). [client]
SERVEUR_URL_PUBLIQUE=https://grc.interne.exemple

# Adresse du reverse proxy de confiance, pour la résolution de l'IP client
# (journalisation des connexions, §1.7). `non` = ne faire confiance à
# aucun en-tête X-Forwarded-*. [socle]
SERVEUR_PROXY_DE_CONFIANCE=127.0.0.1

# Taille maximale d'un corps de requête, en octets (26 Mio par défaut).
# Doit rester <= LimitRequestBody du vhost Apache. [socle]
#
# Le Mio d'écart avec PJ_TAILLE_MAX (§8) est délibéré : une pièce jointe voyage
# dans une enveloppe multipart, dont les frontières et les en-têtes s'ajoutent au
# fichier. Aligner les deux valeurs ferait refuser une pièce jointe pile à la
# taille annoncée comme maximale — un défaut qui ne se voit qu'en production.
SERVEUR_TAILLE_MAX_CORPS=27262976

# fatal | error | warn | info | debug | trace | silent   [socle]
SERVEUR_NIVEAU_JOURNAL=info

# Délai maximal, en millisecondes, laissé aux requêtes en cours lors d'un
# arrêt (SIGTERM). Doit rester < TimeoutStopSec du service systemd. [socle]
SERVEUR_DELAI_ARRET=25000


# =====================================================================
#  3. Base de données PostgreSQL
# =====================================================================
# Rôles créés par install.sh, conformément à backend/db/CONVENTIONS.md §14 :
#   grc_proprietaire  applique les migrations, propriétaire des objets (DDL)
#   grc_app           service applicatif : CRUD, sans DDL, sans BYPASSRLS
#   grc_lecture       supervision / exports d'exploitation (select)

BASE_HOTE=127.0.0.1
BASE_PORT=5432
BASE_NOM=cyber_grc

# Compte du service applicatif. [requis]
BASE_UTILISATEUR=grc_app
BASE_MOT_DE_PASSE=

# Compte propriétaire, utilisé UNIQUEMENT pour appliquer les migrations
# (lot L1). Le service ne s'en sert jamais en fonctionnement normal.
BASE_UTILISATEUR_PROPRIETAIRE=grc_proprietaire
BASE_MOT_DE_PASSE_PROPRIETAIRE=

# Compte de supervision et d'exports d'exploitation (CONVENTIONS.md §14). Le
# service ne s'en sert jamais ; il existe pour que la supervision n'ait pas à
# emprunter le compte applicatif.
BASE_UTILISATEUR_LECTURE=grc_lecture
BASE_MOT_DE_PASSE_LECTURE=

# ⚠️ Les NOMS des trois rôles sont figés par le produit : `001_socle.sql` pose les
# privilèges par défaut sur `grc_app` et `grc_lecture` écrits en clair. Les
# renommer ici donnerait au service un compte valide et AUCUN privilège. Ce sont
# les mots de passe qui se personnalisent, pas les noms.

# desactive | requis | verifie-ca
# `desactive` est le réglage attendu : PostgreSQL n'écoute que sur la
# boucle locale de la même VM (§1.1). Une base déportée impose `verifie-ca`.
BASE_SSL=desactive
BASE_SSL_CA=

# Connexions simultanées du pool. ~10 utilisateurs par filiale et une
# façade synchrone (§1.3) : la charge est faible, un pool étroit suffit
# et protège la base d'une saturation. [socle]
BASE_POOL_MAX=10

# Délais de garde, en millisecondes. [socle]
BASE_DELAI_CONNEXION=5000
BASE_DELAI_INACTIVITE=30000
BASE_DELAI_REQUETE=15000
BASE_DELAI_TRANSACTION_INACTIVE=30000
BASE_DELAI_VERROU=5000


# =====================================================================
#  4. Sessions applicatives
# =====================================================================

# Clé de signature des sessions (>= 32 caractères). [requis en production]
# Engendrée par install.sh, comme les trois mots de passe de base ci-dessus.
# Ce sont les SEULS secrets que le script engendre : ceux qui viennent d'un autre
# système (LDAP, SMTP, compte de secours) se renseignent à la main. La changer déconnecte
# tout le monde — sans autre effet.
SESSION_SECRET=

# Expiration sur inactivité, en minutes (§0.3 : 30 min par défaut).
SESSION_DUREE_INACTIVITE=30

# Durée de vie maximale d'une session, en heures, inactivité ou non.
SESSION_DUREE_MAXIMALE=12

SESSION_NOM_COOKIE=grc_session

# Cookie `Secure` : toujours `oui` en production (TLS obligatoire, §0.2).
SESSION_COOKIE_SECURISE=oui


# Filiale de la session PROVISOIRE, avant que le lot L3 n'apporte
# l'authentification. Code ou identifiant. Vide = la première filiale active par
# ordre de code, avec un avertissement à chaque résolution.
#
# ⚠️ La session provisoire REFUSE de servir en production (NODE_ENV=production) :
# un outil de gouvernance sans authentification ne sert pas de données. Cette
# variable n'a donc de sens qu'en développement et en recette, et L3 la rend caduque.
API_FILIALE_PROVISOIRE=


# =====================================================================
#  5. Authentification — Active Directory (LDAPS)   [lot L3]
# =====================================================================
# Ces variables sont validées dès L0 pour que l'erreur de saisie se voie
# au déploiement, et non le jour de la bascule de l'authentification.

# `non` = authentification AD désactivée (poste de développement,
# environnement de recette sans annuaire).
AUTH_LDAP_ACTIF=oui

# LDAPS obligatoire (le port 389 en clair est refusé par la configuration). [client]
LDAP_URL=ldaps://dc01.exemple.interne:636

# Autorité de certification de la PKI interne, au format PEM. [client]
LDAP_CA=/etc/cyber-grc/ca-active-directory.pem

# Vérification du certificat du contrôleur de domaine. Ne passer à `non`
# qu'en laboratoire : `non` en production annule l'intérêt de LDAPS.
LDAP_VERIFIER_CERTIFICAT=oui

# Compte de service AD, en lecture seule (§1.5). [client]
LDAP_DN_SERVICE=CN=svc-grc,OU=Comptes de service,DC=exemple,DC=interne
LDAP_MOT_DE_PASSE_SERVICE=

# Racine de recherche des comptes et des groupes. [client]
LDAP_BASE_RECHERCHE=DC=exemple,DC=interne

# {login} est remplacé par l'identifiant saisi.
LDAP_FILTRE_UTILISATEUR=(&(objectClass=user)(sAMAccountName={login}))
LDAP_ATTRIBUT_IDENTIFIANT=sAMAccountName

# Attributs alimentant l'annuaire `personnes` depuis l'AD (§1.5).
LDAP_ATTRIBUTS_PROFIL=displayName,givenName,sn,mail,telephoneNumber,department,title

# Préfixe des groupes AD pilotant périmètre et droits (§3.4 :
# GRC-<FILIALE>-<PROFIL>, GRC-GROUPE-<PROFIL>, GRC-EXPORT, GRC-ADMIN). [client]
LDAP_PREFIXE_GROUPES=GRC-

# Résolution récursive des groupes imbriqués (§3.4 : une appartenance
# indirecte doit être reconnue).
LDAP_GROUPES_IMBRIQUES=oui

LDAP_DELAI=8000

# ⚠️ DÉVELOPPEMENT UNIQUEMENT — habilitation d'administration Groupe provisoire.
#
# Tant que le lot L3 n'existe pas, aucune authentification ne peut décider qui
# détient l'administration Groupe. Le serveur refuse donc par défaut toute écriture
# touchant au socle commun : catalogue de mesures, correspondances, politiques de
# portée Groupe, et la reprise d'un export qui en porte.
#
# `oui` accorde cette habilitation à la session provisoire, avec un avertissement à
# chaque résolution. La valeur est **sans effet en production comme en recette** :
# hors développement, le serveur refuse quoi qu'il arrive.
#
# Elle disparaîtra avec L3, qui la remplacera par le profil Administration résolu
# depuis les groupes AD. Aucune route ne pose ce drapeau elle-même — elle le
# vérifie : c'est ce qui rend la règle impossible à enfreindre par oubli.
API_ADMINISTRATION_GROUPE_PROVISOIRE=non

# Compte administrateur de secours, indépendant de l'AD (§0.3), pour le cas
# où le compte de service serait verrouillé. Vide = compte de secours désactivé.
#
# L'empreinte est AUTO-DESCRIPTIVE, et son format est ici parce qu'un exploitant
# qui doit en fabriquer une à 3 h du matin ne lira pas le code :
#
#     scrypt$N$r$p$sel$empreinte          (les deux derniers en base64url)
#
# Elle s'engendre par `engendrerEmpreinte()` de `src/auth/secours.ts`. Chaque
# usage du compte de secours est journalisé, réussi COMME refusé.
AUTH_COMPTE_SECOURS_IDENTIFIANT=secours
AUTH_COMPTE_SECOURS_EMPREINTE=

# Limitation du rythme des tentatives de connexion (§1.9).
AUTH_MAX_TENTATIVES=5
AUTH_DUREE_VERROUILLAGE=15

# Limitation du rythme des requêtes NON AUTHENTIFIÉES, au point d'entrée de
# l'API (condition E4). C'est l'autre moitié de la limitation ci-dessus : celle-là
# borne les tentatives de CONNEXION, celle-ci le martèlement par quelqu'un qui
# n'a pas de session — la requête qui ne coûte rien à émettre et n'est
# attribuable à personne.
#
# ⚠️ Elle compte PAR ADRESSE, et une adresse se change : ce n'est pas une parade
# au déni de service distribué. Inversement, dix personnes derrière la même
# passerelle VPN partagent une adresse — la monter trop bas peut viser un site
# entier. Ces deux réglages existaient comme un EMPRUNT aux valeurs de connexion
# (AUTH_MAX_TENTATIVES × 4) : un emprunt écrit dans le code n'est pas un réglage.
API_RYTHME_MAX_ANONYME=20
API_RYTHME_FENETRE=15

# Intervalle de relecture de l'annuaire pour une session DÉJÀ ouverte, en
# minutes. C'est le délai maximal entre le retrait d'un compte de l'AD et la
# coupure de ses sessions en cours — le déprovisionnement du `PLAN_SERVEUR`
# §1.5 ne se contente pas de la connexion suivante.
#
# ⚠️ Le baisser rapproche la coupure et charge le contrôleur de domaine ; le
# monter fait l'inverse. Ce n'est donc PAS un réglage de confort : c'est la
# durée pendant laquelle un compte révoqué continue de travailler.
AUTH_REVERIFICATION_AD=5


# =====================================================================
#  6. Notifications par courriel (SMTP)   [lot L12]
# =====================================================================
# Fonction non bloquante : le serveur démarre et fonctionne normalement
# si le relais est injoignable (§1.11).

SMTP_ACTIF=non

# Office 365 : smtp.office365.com:587 en STARTTLS. [client]
SMTP_HOTE=
SMTP_PORT=587

# starttls | tls | aucun
SMTP_CHIFFREMENT=starttls

# aucun | basique | oauth2
# Microsoft a largement fermé l'authentification SMTP basique (§1.11) :
# selon le tenant, `oauth2` est la seule voie ouverte.
SMTP_MODE_AUTH=basique
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=

# Mode `oauth2` uniquement (enregistrement d'application Entra ID). [client]
SMTP_OAUTH_TENANT=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=

# Adresse d'expédition — une autorisation SPF est nécessaire côté client,
# sans quoi tout part en indésirable (§1.11). [client]
SMTP_EXPEDITEUR=cyber-grc@exemple.fr
SMTP_NOM_EXPEDITEUR=Cyber GRC Groupe

# RECETTE UNIQUEMENT : redirige TOUTES les notifications vers cette adresse
# au lieu des destinataires réels. Interdit l'incident classique de la
# campagne de relances partie de la recette vers vingt filiales (§1.10).
# Doit rester vide en production.
SMTP_REDIRECTION_RECETTE=


# =====================================================================
#  7. Chemins sur le disque
# =====================================================================
# Chemins ABSOLUS. Le magasin de pièces jointes et la quarantaine doivent
# rester HORS de l'arborescence servie par Apache (§1.6, contrôle n° 5) —
# le serveur refuse de démarrer s'ils sont sous CHEMIN_FRONTEND.

CHEMIN_PIECES_JOINTES=/var/lib/cyber-grc/pieces-jointes
CHEMIN_QUARANTAINE=/var/lib/cyber-grc/quarantaine
CHEMIN_TEMPORAIRE=/var/lib/cyber-grc/temporaire

# Frontend statique servi par Apache (DocumentRoot du vhost).
CHEMIN_FRONTEND=/opt/cyber-grc/frontend

# Configuration propre au client, hors socle (§0.5) : nomenclature des
# groupes AD, profils métier, référentiels imposés, marque par défaut.
# Fichier JSON, absent = valeurs du socle.
CHEMIN_CONFIG_SPECIFIQUE=/etc/cyber-grc/specifique.json

# Racine des sauvegardes (base + journaux de transactions, §1.8).
CHEMIN_SAUVEGARDES=/var/backups/cyber-grc


# =====================================================================
#  8. Pièces jointes et analyse antivirale   [lot L6]
# =====================================================================

# Taille maximale par fichier, en Mio (§1.6, contrôle n° 8).
PJ_TAILLE_MAX=25

# Quota par filiale, en Mio. 10 à 15 Go pour vingt filiales sur trois ans
# est l'ordre de grandeur estimé au cadrage.
PJ_QUOTA_FILIALE=2048

# ClamAV écoute sur une socket locale, jamais sur le réseau (§1.1).
CLAMAV_ACTIF=oui
CLAMAV_SOCKET=/run/clamav/clamd.ctl
CLAMAV_DELAI=30000


# =====================================================================
#  9. Rétention
# =====================================================================

# Journal d'audit : 3 ans (§1.7). 1095 jours.
RETENTION_JOURNAL=1095

# Données métier : 3 ans, puis archivage ou purge (§2.7).
RETENTION_DONNEES=1095
